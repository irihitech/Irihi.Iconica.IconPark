<UserControl
    x:Class="IconDemo.Views.TDesignSettingPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewModels="clr-namespace:IconDemo.ViewModels"
    Width="400"
    x:DataType="viewModels:TDesignSettingPanelViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <viewModels:TDesignSettingPanelViewModel />
    </Design.DataContext>
    <Border Theme="{DynamicResource CardBorder}">
        <ScrollViewer Theme="{DynamicResource StaticScrollViewer}">
            <u:Form HorizontalAlignment="Stretch">
                <u:FormItem Label="图标大小">
                    <DockPanel LastChildFill="True">
                        <u:NumericDoubleUpDown
                            Width="100"
                            AllowDrag="True"
                            DockPanel.Dock="Right"
                            Maximum="{Binding #size.Maximum}"
                            Minimum="{Binding #size.Minimum}"
                            Value="{Binding #size.Value}" />
                        <Slider
                            Name="size"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="128"
                            Minimum="12"
                            TickFrequency="1"
                            Value="{Binding Size}" />
                    </DockPanel>
                </u:FormItem>
                <u:FormItem Label="线条粗细">
                    <DockPanel LastChildFill="True">
                        <u:NumericDoubleUpDown
                            Width="100"
                            AllowDrag="True"
                            DockPanel.Dock="Right"
                            Maximum="{Binding #thickness.Maximum}"
                            Minimum="{Binding #thickness.Minimum}"
                            Value="{Binding #thickness.Value}" />
                        <Slider
                            Name="thickness"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="4"
                            Minimum="1"
                            TickFrequency="1"
                            Value="{Binding StrokeWidth}" />
                    </DockPanel>
                </u:FormItem>
                <u:SelectionList
                    Name="variant"
                    u:FormItem.Label="图标变体"
                    ItemsSource="{Binding Variants}"
                    SelectedItem="{Binding SelectedVariant}">
                    <u:SelectionList.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Margin" Value="4" />
                        </Style>
                    </u:SelectionList.Styles>
                    <u:SelectionList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </u:SelectionList.ItemsPanel>
                </u:SelectionList>
                <u:SelectionList
                    Name="mode"
                    u:FormItem.Label="图标风格（颜色）"
                    ItemsSource="{Binding Modes}"
                    SelectedItem="{Binding SelectedMode}">
                    <u:SelectionList.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Margin" Value="4" />
                        </Style>
                    </u:SelectionList.Styles>
                    <u:SelectionList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </u:SelectionList.ItemsPanel>
                </u:SelectionList>
                <u:FormItem NoLabel="True">
                    <UniformGrid Columns="2">
                        <UniformGrid.Styles>
                            <Style Selector="ColorPicker">
                                <Setter Property="Theme" Value="{StaticResource SimpleColorPicker}" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                            <Style Selector="ColorPicker DropDownButton">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Style Selector="^ /template/ PathIcon">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                            </Style>
                            <Style Selector="Grid.Root">
                                <Setter Property="Margin" Value="8 4" />
                            </Style>
                        </UniformGrid.Styles>
                        <Grid
                            Classes="Root"
                            ColumnDefinitions="Auto, *"
                            RowDefinitions="*, *">
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="主描边" />
                            <SelectableTextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Stroke1Color}" />
                            <ColorPicker
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Width="{x:Static x:Double.NaN}"
                                HorizontalAlignment="Stretch"
                                Color="{Binding Stroke1Color}" />
                        </Grid>
                        <Grid
                            Classes="Root"
                            ColumnDefinitions="Auto, *"
                            RowDefinitions="*, *">
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="主填充" />
                            <SelectableTextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Fill1Color}" />
                            <ColorPicker
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Width="{x:Static x:Double.NaN}"
                                HorizontalAlignment="Stretch"
                                Color="{Binding Fill1Color}" />
                        </Grid>
                        <Grid
                            Classes="Root"
                            ColumnDefinitions="Auto, *"
                            RowDefinitions="*, *">
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="辅描边" />
                            <SelectableTextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Stroke2Color}" />
                            <ColorPicker
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Width="{x:Static x:Double.NaN}"
                                HorizontalAlignment="Stretch"
                                Color="{Binding Stroke2Color}" />
                        </Grid>
                        <Grid
                            Classes="Root"
                            ColumnDefinitions="Auto, *"
                            RowDefinitions="*, *">
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="辅填充" />
                            <SelectableTextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Fill2Color}" />
                            <ColorPicker
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Width="{x:Static x:Double.NaN}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Color="{Binding Fill2Color}" />
                        </Grid>
                    </UniformGrid>
                </u:FormItem>
                <Button
                    HorizontalAlignment="Stretch"
                    u:FormItem.NoLabel="True"
                    Classes="Tertiary"
                    Command="{Binding ResetCommand}"
                    Content="还原色彩" />
            </u:Form>
        </ScrollViewer>
    </Border>
</UserControl>
